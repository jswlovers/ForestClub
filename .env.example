# 서버
PORT=3000
# 운영 배포(HTTPS) 시 production으로 설정하면 세션 쿠키에 secure 플래그가 붙습니다.
NODE_ENV=development
# Nginx 등 리버스 프록시 뒤에서 실행할 때만 true로 설정하세요. 프록시 없이 true로 두면
# 누구나 X-Forwarded-For 헤더를 조작해 요청 제한(rate limit)을 우회할 수 있습니다.
TRUST_PROXY=false

# 최초 실행 시 자동 생성되는 관리자 계정. 운영 배포 전 반드시 바꿔주세요.
ADMIN_EMAIL=admin@forestclub.kr
ADMIN_PASSWORD=admin1234!

# ── SMS 발송 ──────────────────────────────────────────────
# mock: 실제 발송 없이 콘솔 출력 + notifications 테이블에 기록만 함 (기본값)
# solapi: 아래 SOLAPI_* 키를 모두 채우면 Solapi API로 실제 문자 발송
SMS_PROVIDER=mock
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# ── 카카오 알림톡(선택) ───────────────────────────────────
# 카카오 비즈니스 채널(https://business.kakao.com)을 만들고, 아래 종류별로 알림톡
# 템플릿을 등록해 심사 승인을 받은 뒤 templateId를 채우면 해당 알림부터 자동으로
# SMS 대신 알림톡으로 전환된다 (SOLAPI_* 키도 함께 필요). 비워두면 전부 SMS로 발송.
KAKAO_PF_ID=
KAKAO_TEMPLATE_WELCOME=
KAKAO_TEMPLATE_APPLICATION_RECEIVED=
KAKAO_TEMPLATE_APPROVED=
KAKAO_TEMPLATE_REJECTED=
KAKAO_TEMPLATE_COMPANION_REQUEST=
KAKAO_TEMPLATE_COMPANION_RESPONSE=
KAKAO_TEMPLATE_PASSWORD_RESET=
KAKAO_TEMPLATE_COIN_CHARGE_APPROVED=
KAKAO_TEMPLATE_COIN_CHARGE_REJECTED=
KAKAO_TEMPLATE_NEW_MESSAGE=

# ── 코인 충전 결제(토스페이먼츠, 선택) ───────────────────────
# 비워두면 회원은 '충전 신청'만 하고, 관리자가 입금 확인 후 관리자 페이지에서
# 수동으로 승인합니다 (즉시 사용 가능). TOSS_SECRET_KEY를 채우면 /api/coins/toss/confirm
# 엔드포인트가 실제 결제 승인을 시도합니다 — 단, 토스 위젯(클라이언트 키, 결제 UI)은
# 별도로 프론트엔드에 붙여야 하며 여기서는 서버 승인 API 연동만 준비되어 있습니다.
TOSS_SECRET_KEY=
